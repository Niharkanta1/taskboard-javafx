<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <Label fx:id="titleLabel" styleClass="dialog-title" text="Create Workspace" />
    </top>

    <center>
        <VBox styleClass="workspace-dialog" spacing="8">
            <Label text="Name" />
            <TextField fx:id="nameField" promptText="Workspace name" />
            <Label text="Description" />
            <TextArea fx:id="descriptionField" promptText="Optional description" prefRowCount="4" />
            <Label fx:id="errorLabel" styleClass="dialog-error" text="" wrapText="true" />
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-actions" spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" />
            <Button fx:id="saveButton" styleClass="dialog-save" text="Save" onAction="#onSave" />
        </HBox>
    </bottom>

</BorderPane>
