<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <Label styleClass="dialog-title" text="Manage Tags &amp; Labels" />
    </top>

    <center>
        <VBox styleClass="workspace-dialog" spacing="12">
            <Label styleClass="form-label" text="Existing Tags" />
            <ListView fx:id="tagsListView" prefHeight="170" />

            <Label fx:id="formSectionTitle" styleClass="form-label" text="Create New Tag" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tagNameField" promptText="Tag name (e.g. Bug, Feature)" HBox.hgrow="ALWAYS" />
                <ColorPicker fx:id="tagColorPicker" prefWidth="120" />
            </HBox>

            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button fx:id="cancelEditButton" styleClass="dialog-cancel" text="Cancel Edit" visible="false" managed="false" onAction="#onCancelEdit" />
                <Button fx:id="saveTagButton" styleClass="dialog-save" text="+ Add Tag" onAction="#onSaveTag" />
            </HBox>

            <Label fx:id="errorLabel" styleClass="dialog-error" text="" wrapText="true" />
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-actions" spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="closeButton" styleClass="dialog-cancel" text="Close" onAction="#onClose" defaultButton="true" />
        </HBox>
    </bottom>

</BorderPane>
