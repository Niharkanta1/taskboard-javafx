<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <Label fx:id="titleLabel" styleClass="dialog-title" text="New Card" />
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox styleClass="workspace-dialog" spacing="10">
                    <Label styleClass="form-label" text="Title" />
                    <TextField fx:id="titleField" promptText="Card title" />
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Column" />
                            <ChoiceBox fx:id="columnChoice" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Priority" />
                            <ChoiceBox fx:id="priorityChoice" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Severity" />
                            <ChoiceBox fx:id="severityChoice" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Due Date" />
                            <DatePicker fx:id="dueDatePicker" maxWidth="Infinity" />
                        </VBox>
                    </HBox>
                    <VBox spacing="4">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label styleClass="form-label" text="Tags &amp; Labels" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="manageTagsButton" styleClass="column-action-button" text="⚙ Manage Tags" onAction="#onManageTags" />
                        </HBox>
                        <FlowPane fx:id="tagsFlowPane" hgap="8" vgap="6" styleClass="tags-container" style="-fx-padding: 2px 0;" />
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="form-label" text="Checklists" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addChecklistButton" styleClass="mode-button" text="+ Add Checklist" onAction="#onAddChecklist" />
                    </HBox>
                    <VBox fx:id="checklistsContainer" spacing="15" />
                    <Label styleClass="form-label" text="Description (Markdown)" />
                    <HBox styleClass="description-mode-bar" spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="editButton" styleClass="mode-button" text="Edit" onAction="#onEditMode" />
                        <Button fx:id="previewButton" styleClass="mode-button" text="Preview" onAction="#onPreviewMode" />
                        <Button fx:id="attachButton" styleClass="mode-button" text="Attach Image" onAction="#onAttachImage" />
                    </HBox>
                    <ScrollPane styleClass="dialog-scroll" fitToWidth="true" fitToHeight="true" prefHeight="160" VBox.vgrow="ALWAYS" minHeight="160">
                        <content>
                            <StackPane>
                                <TextArea fx:id="descriptionField" promptText="Markdown source" />
                                <VBox fx:id="descriptionPreview" styleClass="card-markdown" spacing="4" />
                            </StackPane>
                        </content>
                    </ScrollPane>
                    <Label fx:id="errorLabel" styleClass="dialog-error" text="" wrapText="true" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox styleClass="dialog-actions" spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="deleteButton" styleClass="dialog-delete" text="Delete" onAction="#onDelete" visible="false" managed="false" />
            <Button fx:id="cancelButton" styleClass="dialog-cancel" text="Cancel" onAction="#onCancel" />
            <Button fx:id="saveButton" styleClass="dialog-save" text="Save" onAction="#onSave" defaultButton="true" />
        </HBox>
    </bottom>
</BorderPane>